# Nibras — client-side environment variables (placeholders only, never
# real secrets — see server/README.md for the server-side AI backend's
# own env vars, which are NOT client-side and must never go here).

# Base URL of the deployed AI backend (server/README.md). A plain URL,
# not a secret — safe to be public. Leave unset/empty to run every AI
# feature (Reading Buddy voice, AI Assistant, Mind Maps) in DEMO mode,
# which needs no backend at all. Example once a backend is deployed:
# VITE_AI_BACKEND_URL=https://api.nibrasapp.com
VITE_AI_BACKEND_URL=
